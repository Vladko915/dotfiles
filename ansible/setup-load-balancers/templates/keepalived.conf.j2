global_defs {
    router_id {{ inventory_hostname }}
}

vrrp_instance VI_1 {

    state {{ keepalived_state }}

    interface {{ hostvars['keepalived-settings']['keepalived_interface'] }}

    virtual_router_id {{ hostvars['keepalived-settings']['keepalived_virtual_router_id'] }}

    priority {{ keepalived_priority }}

    advert_int {{ hostvars['keepalived-settings']['keepalived_advert_int'] }}

    authentication {
        auth_type {{ hostvars['keepalived-settings']['keepalived_auth_type'] }}
        auth_pass {{ hostvars['keepalived-settings']['keepalived_auth_pass'] }}
    }

    virtual_ipaddress {
        {{ hostvars['kubernetes-api']['vip_host'] }}/24
    }
}